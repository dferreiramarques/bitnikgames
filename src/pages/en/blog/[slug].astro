---
import { getCollection } from "astro:content";
import BlogDetailPage from "../../../components/BlogDetailPage.astro";

export async function getStaticPaths() {
  const entries = await getCollection("posts", ({ id }) => id.startsWith("en/"));
  return entries.map((entry) => {
    const slug = entry.id.split("/").slice(1).join("/");
    return { params: { slug }, props: { entry, slug } };
  });
}

const { entry, slug } = Astro.props;
---

<BlogDetailPage locale="en" entry={entry} slug={slug} />
