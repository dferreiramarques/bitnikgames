---
import { getCollection } from "astro:content";
import CatalogDetailPage from "../../../components/CatalogDetailPage.astro";

export async function getStaticPaths() {
  const entries = await getCollection("games", ({ id }) => id.startsWith("pt/"));
  return entries.map((entry) => {
    const slug = entry.id.split("/").slice(1).join("/");
    return { params: { slug }, props: { entry, slug } };
  });
}

const { entry, slug } = Astro.props;
---

<CatalogDetailPage locale="pt" entry={entry} slug={slug} />
