---
import type { CollectionEntry } from "astro:content";
import Badge from "./Badge.astro";
import { pathTo, type Locale } from "../i18n/routes";
import { t } from "../i18n/ui";
import { entryBadge } from "../lib/badges";
import { hasCoverImage } from "../lib/coverImage";

interface Props {
  locale: Locale;
  game: CollectionEntry<"games">;
  slug: string;
}

const { locale, game, slug } = Astro.props;
const copy = t(locale).catalog;
const { title, shortDescription, players, duration, age, status, price } = game.data;

const badge = entryBadge(locale, status, price);
const href = pathTo(locale, "catalog", slug);
const coverSrc = hasCoverImage(slug) ? `/cards/${slug}.png` : null;
---

<a class="card" href={href}>
  <div class="card-media" aria-hidden="true">
    {coverSrc ? <img src={coverSrc} alt="" /> : title}
  </div>
  <div class="card-body">
    <div class="card-meta">
      {players && (
        <span>{players.min === players.max ? players.min : `${players.min}–${players.max}`} {copy.players}</span>
      )}
      {duration && <span>{duration} {copy.duration}</span>}
      {age && <span>{age} {copy.age}</span>}
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-excerpt">{shortDescription}</p>
    <div class="card-footer">
      <Badge variant={badge.variant} label={badge.label} />
      {status === "buy-now" && price ? <strong>{price}</strong> : null}
    </div>
  </div>
</a>
