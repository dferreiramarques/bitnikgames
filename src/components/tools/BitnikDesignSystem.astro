---
import Layout from "../../layouts/Layout.astro";
import { pathTo, type Locale } from "../../i18n/routes";
import { t } from "../../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).tools;
const otherLocale: Locale = locale === "pt" ? "en" : "pt";

const title = "Bitnik Design System";
const description =
  locale === "pt"
    ? "Os tokens e componentes que garantem consistência visual entre o site e os jogos online da bitnikgames — CSS puro, open source, pronto a reutilizar noutro projeto."
    : "The tokens and components that keep the site and bitnikgames' online games visually consistent — plain CSS, open source, ready to reuse in another project.";

const REPO_URL = "https://github.com/dferreiramarques/bitnikgames-design-system";
const SKIN_BUILDER_URL = "https://dferreiramarques.github.io/bitnikgames-design-system/skin-builder/";

const STRINGS = {
  pt: {
    subtitle: "Design system · CSS puro, open source",
    ghCta: "Ver no GitHub",
    license: "Licença MIT",
    intro:
      "Extraído do código deste site em 2026 para manter a mesma identidade visual entre a bitnikgames.vercel.app e os jogos online do catálogo — sem copiar e colar CSS entre projetos. Zero dependências, zero build step obrigatório: funciona em Astro, React, Vue, ou HTML simples.",
    install: {
      heading: "Instalar",
      npmLabel: "Via npm (num projeto com bundler)",
      cdnLabel: "Sem npm (HTML simples, via jsDelivr)",
      fontsLabel: "Carregar as fontes",
      fontsNote: "O CSS só define a stack (--font-display, --font-body) — as fontes em si carregam-se à parte.",
    },
    skinBuilder: {
      heading: "Criar uma skin",
      body: "A única camada que precisas de tocar para adaptar isto a outra marca é tokens.css — escolhe a paleta e as Google Fonts visualmente nesta página, com pré-visualização ao vivo usando o base.css e o components.css reais do pacote, e exporta um tokens.css novo.",
      cta: "Abrir o Skin Builder",
    },
    tokens: {
      heading: "Tokens",
      subhead: "A única camada que uma \"skin\" deve tocar — muda estas variáveis e todo o resto segue.",
      colorsHeading: "Cor",
      radiusHeading: "Forma (border-radius)",
      shadowHeading: "Sombra",
      shadowNote: "Deriva de --shadow-color-rgb — muda a tinta (--color-ink) da skin e a sombra segue, em vez de ficar preta fixa.",
      typeHeading: "Tipografia",
      typeDisplay: "--font-display · Baloo 2",
      typeDisplaySample: "Jogos publicados",
      typeBody: "--font-body · Inter",
      typeBodySample: "Texto de corpo, legível em qualquer tamanho — usado em parágrafos, listas e formulários.",
    },
    components: {
      heading: "Componentes base",
      subhead: "Layout, botões, badges e cartões — o que qualquer site de marketing ou catálogo precisa.",
      buttonsHeading: "Botões",
      badgesHeading: "Badges",
      badgesNote:
        "Aqui usam os nomes específicos deste site (badge-free, badge-paid...). No pacote standalone são generalizados para badge-accent / badge-primary / badge-secondary / badge-outline / badge-ink, para fazer sentido fora do contexto de jogos.",
      cardsHeading: "Cartões",
    },
    gameUi: {
      heading: "Camada opcional: UI de jogo",
      subhead:
        "Não faz parte do import por omissão — só importa game-ui.css em projetos com tabuleiro/cartas. Extraído dos jogos reais no catálogo \"Jogar Online\".",
      chipsHeading: "Chips de cor",
      chipsNote: "Para referenciar jogador/equipa/naipe de forma legível — 4 tokens de cor (--game-color-1..4) que cada jogo sobrescreve com a sua paleta.",
      cardsHeading: "Cartas de jogo",
      cardsNote: "Arte real do Bulbous — hover para veres o lift + sombra. .badge-circle sobrepõe a numeração, .game-card-bar dá a barra de legenda inferior.",
      diceHeading: "Dados",
      diceNote: "O mesmo padrão de pips (grelha 3×3 + --shadow-color-rgb) usado nos 9 dados do Nine Oils, aqui parado numa jogada de exemplo.",
      tabsHeading: "Tabs",
      modalHeading: "Modal",
      modalNote: "(mostrado fora do overlay position:fixed, só para ver o estilo da caixa)",
      modalTitle: "Confirmar jogada?",
      modalBody: "Este é o .modal-box — usado nos popups de detalhe de carta e confirmações dentro dos jogos.",
      toastHeading: "Toast",
    },
    games: {
      heading: "Jogos que já o usam",
      subhead: "Cada um com a sua própria paleta — tipografia, raio e sombra partilhados.",
      play: "Jogar",
    },
    footerCta: "Ver a documentação completa no README →",
  },
  en: {
    subtitle: "Design system · plain CSS, open source",
    ghCta: "View on GitHub",
    license: "MIT license",
    intro:
      "Extracted from this site's code in 2026 to keep the same visual identity between bitnikgames.vercel.app and the catalog's online games — without copy-pasting CSS between projects. Zero dependencies, no required build step: works in Astro, React, Vue, or plain HTML.",
    install: {
      heading: "Install",
      npmLabel: "Via npm (in a bundled project)",
      cdnLabel: "No npm (plain HTML, via jsDelivr)",
      fontsLabel: "Load the fonts",
      fontsNote: "The CSS only defines the stack (--font-display, --font-body) — the fonts themselves load separately.",
    },
    skinBuilder: {
      heading: "Build a skin",
      body: "The only layer you need to touch to adapt this to another brand is tokens.css — pick a palette and Google Fonts visually on this page, with a live preview using the package's real base.css and components.css, and export a new tokens.css.",
      cta: "Open the Skin Builder",
    },
    tokens: {
      heading: "Tokens",
      subhead: "The only layer a \"skin\" should touch — change these variables and everything else follows.",
      colorsHeading: "Color",
      radiusHeading: "Shape (border-radius)",
      shadowHeading: "Shadow",
      shadowNote: "Derives from --shadow-color-rgb — change the skin's ink color and the shadow follows, instead of staying flat black.",
      typeHeading: "Typography",
      typeDisplay: "--font-display · Baloo 2",
      typeDisplaySample: "Published games",
      typeBody: "--font-body · Inter",
      typeBodySample: "Body copy, legible at any size — used in paragraphs, lists, and forms.",
    },
    components: {
      heading: "Base components",
      subhead: "Layout, buttons, badges, and cards — what any marketing or catalog site needs.",
      buttonsHeading: "Buttons",
      badgesHeading: "Badges",
      badgesNote:
        "Shown here with this site's specific names (badge-free, badge-paid...). In the standalone package they're generalized to badge-accent / badge-primary / badge-secondary / badge-outline / badge-ink, to make sense outside a games context.",
      cardsHeading: "Cards",
    },
    gameUi: {
      heading: "Optional layer: game UI",
      subhead:
        "Not part of the default import — only import game-ui.css in projects with a board/cards. Extracted from the real games in the \"Play Online\" catalog.",
      chipsHeading: "Color chips",
      chipsNote: "For referencing player/team/suit legibly — 4 color tokens (--game-color-1..4) that each game overrides with its own palette.",
      cardsHeading: "Game cards",
      cardsNote: "Real Bulbous artwork — hover to see the lift + shadow. .badge-circle overlays the numbering, .game-card-bar gives the bottom caption bar.",
      diceHeading: "Dice",
      diceNote: "The same pip pattern (3×3 grid + --shadow-color-rgb) used for Nine Oils' 9 dice, frozen here on a sample roll.",
      tabsHeading: "Tabs",
      modalHeading: "Modal",
      modalNote: "(shown outside the position:fixed overlay, just to see the box style)",
      modalTitle: "Confirm move?",
      modalBody: "This is .modal-box — used for card-detail popups and confirmations inside the games.",
      toastHeading: "Toast",
    },
    games: {
      heading: "Games already using it",
      subhead: "Each with its own palette — typography, radius, and shadow shared.",
      play: "Play",
    },
    footerCta: "See the full documentation in the README →",
  },
} as const;

const L = STRINGS[locale];

const colorTokens = [
  { name: "--color-yellow", hex: "#e8a93b" },
  { name: "--color-yellow-deep", hex: "#c4841f" },
  { name: "--color-orange", hex: "#ea7c2e" },
  { name: "--color-orange-deep", hex: "#c85f1d" },
  { name: "--color-brick", hex: "#b8461f" },
  { name: "--color-brick-deep", hex: "#8f3417" },
  { name: "--color-cream", hex: "#fbf3e4" },
  { name: "--color-cream-soft", hex: "#f3e4cb" },
  { name: "--color-cream-strong", hex: "#ecd6ac" },
  { name: "--color-ink", hex: "#2b1b12" },
  { name: "--color-ink-soft", hex: "#5b4636" },
  { name: "--color-white", hex: "#fffaf1" },
];

const radiusTokens = [
  { name: "--radius-sm", value: "8px" },
  { name: "--radius-md", value: "14px" },
  { name: "--radius-lg", value: "24px" },
  { name: "--radius-pill", value: "999px" },
];

const games = [
  {
    name: "Bulbous",
    url: "https://bulbous.up.railway.app/",
    repo: "https://github.com/dferreiramarques/bulbous",
    note:
      locale === "pt"
        ? "Tema escuro, acento lilás. Primeiro a usar .game-card, .chip e .badge-circle."
        : "Dark theme, lilac accent. First to use .game-card, .chip, and .badge-circle.",
  },
  {
    name: "Capivaras",
    url: "https://capivaras.up.railway.app/",
    repo: "https://github.com/dferreiramarques/capivaras",
    note:
      locale === "pt"
        ? "Tema claro e quente, âmbar + teal. Primeiro a usar --shadow-color-rgb corretamente."
        : "Warm light theme, amber + teal. First to use --shadow-color-rgb correctly.",
  },
  {
    name: "Catania",
    url: "https://catania.up.railway.app/",
    repo: "https://github.com/dferreiramarques/catania-v2",
    note:
      locale === "pt"
        ? "Tema dourado sobre quase-preto. Texto SVG com var(--font-display) no mapa de hexágonos."
        : "Gold-on-near-black theme. SVG text using var(--font-display) on the hex-grid map.",
  },
  {
    name: "Nine Oils",
    url: "https://nineoils.up.railway.app/",
    repo: "https://github.com/dferreiramarques/nineoils-v2",
    note:
      locale === "pt"
        ? "Tema óleo de cobra, dourado sobre madeira escura. Os 9 dados usam o padrão .die/.dot."
        : "Snake-oil theme, gold on dark wood. The 9 dice use the .die/.dot pattern.",
  },
];

// Padrão de pips extraído do Nine Oils (server.js, const DOTS) — posições
// 0-8 numa grelha 3×3. Congelado numa jogada de exemplo só para ilustrar.
const sampleRoll = [3, 5, 5, 2, 6, 5, 1, 4, 5];
const DOTS: Record<number, number[]> = {
  1: [4],
  2: [2, 6],
  3: [2, 4, 6],
  4: [0, 2, 6, 8],
  5: [0, 2, 4, 6, 8],
  6: [0, 2, 3, 5, 6, 8],
};
---

<Layout
  locale={locale}
  altPath={pathTo(otherLocale, "tools", "bitnik-design-system")}
  title={title}
  description={description}
>
  <section class="section ds-page">
    <div class="container">
      <a class="back-link" href={pathTo(locale, "tools")}>&larr; {copy.backToTools}</a>

      <div class="section-head">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="ds-hero-actions">
          <a class="btn btn-primary" href={REPO_URL} target="_blank" rel="noreferrer">{L.ghCta} &rarr;</a>
          <span class="badge badge-soon">{L.license}</span>
        </div>
      </div>

      <p class="ds-intro">{L.intro}</p>

      <!-- ============================== instalar ============================== -->
      <div class="ds-block">
        <h2>{L.install.heading}</h2>

        <p class="ds-label">{L.install.npmLabel}</p>
        <pre class="ds-code"><code>npm install git+https://github.com/dferreiramarques/bitnikgames-design-system.git</code></pre>
        <pre class="ds-code"><code>{`@import "@bitnikgames/design-system/src/index.css";`}</code></pre>

        <p class="ds-label">{L.install.cdnLabel}</p>
        <pre class="ds-code"><code>{`<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/dferreiramarques/bitnikgames-design-system@main/src/index.css" />`}</code></pre>

        <p class="ds-label">{L.install.fontsLabel}</p>
        <pre class="ds-code"><code>{`<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />`}</code></pre>
        <p class="ds-note">{L.install.fontsNote}</p>
      </div>

      <!-- ============================== skin builder ============================== -->
      <div class="ds-block ds-skin-builder">
        <h2>{L.skinBuilder.heading}</h2>
        <p class="ds-note">{L.skinBuilder.body}</p>
        <a class="btn btn-secondary" href={SKIN_BUILDER_URL} target="_blank" rel="noreferrer">{L.skinBuilder.cta} &rarr;</a>
      </div>

      <!-- ============================== tokens ============================== -->
      <div class="ds-block">
        <h2>{L.tokens.heading}</h2>
        <p class="ds-note">{L.tokens.subhead}</p>

        <h3>{L.tokens.colorsHeading}</h3>
        <div class="ds-swatch-grid">
          {colorTokens.map((c) => (
            <div class="ds-swatch">
              <div class="ds-swatch-color" style={`background:${c.hex}`}></div>
              <code>{c.name}</code>
              <span>{c.hex}</span>
            </div>
          ))}
        </div>

        <h3>{L.tokens.radiusHeading}</h3>
        <div class="ds-radius-row">
          {radiusTokens.map((r) => (
            <div class="ds-radius-item">
              <div class="ds-radius-box" style={`border-radius:${r.value}`}></div>
              <code>{r.name}</code>
              <span>{r.value}</span>
            </div>
          ))}
        </div>

        <h3>{L.tokens.shadowHeading}</h3>
        <div class="ds-shadow-row">
          <div class="ds-shadow-box ds-shadow-card">shadow-card</div>
          <div class="ds-shadow-box ds-shadow-card-hover">shadow-card-hover</div>
        </div>
        <p class="ds-note">{L.tokens.shadowNote}</p>

        <h3>{L.tokens.typeHeading}</h3>
        <div class="ds-type-row">
          <div>
            <code>{L.tokens.typeDisplay}</code>
            <p class="ds-type-display">{L.tokens.typeDisplaySample}</p>
          </div>
          <div>
            <code>{L.tokens.typeBody}</code>
            <p class="ds-type-body">{L.tokens.typeBodySample}</p>
          </div>
        </div>
      </div>

      <!-- ============================== componentes base ============================== -->
      <div class="ds-block">
        <h2>{L.components.heading}</h2>
        <p class="ds-note">{L.components.subhead}</p>

        <h3>{L.components.buttonsHeading}</h3>
        <div class="ds-row">
          <button class="btn btn-primary">btn-primary</button>
          <button class="btn btn-secondary">btn-secondary</button>
          <button class="btn btn-outline">btn-outline</button>
        </div>

        <h3>{L.components.badgesHeading}</h3>
        <div class="ds-row">
          <span class="badge badge-free">badge-free</span>
          <span class="badge badge-paid">badge-paid</span>
          <span class="badge badge-pwyw">badge-pwyw</span>
          <span class="badge badge-soon">badge-soon</span>
          <span class="badge badge-external">badge-external</span>
        </div>
        <p class="ds-note">{L.components.badgesNote}</p>

        <h3>{L.components.cardsHeading}</h3>
        <div class="grid grid-3">
          <div class="card">
            <div class="card-media" aria-hidden="true">Bulbous</div>
            <div class="card-body">
              <div class="card-meta"><span>2–4</span><span>30 min</span></div>
              <h3 class="card-title">Bulbous</h3>
              <p class="card-excerpt">.card + .card-media + .card-body</p>
            </div>
          </div>
          <div class="card">
            <div class="card-media" aria-hidden="true">Capivaras</div>
            <div class="card-body">
              <div class="card-meta"><span>2–6</span><span>20 min</span></div>
              <h3 class="card-title">Capivaras</h3>
              <p class="card-excerpt">.card-title + .card-excerpt</p>
            </div>
          </div>
          <div class="card">
            <div class="card-media" aria-hidden="true">Catania</div>
            <div class="card-body">
              <div class="card-meta"><span>2–4</span><span>45 min</span></div>
              <h3 class="card-title">Catania</h3>
              <p class="card-excerpt">.card-meta + .card-footer</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================== game-ui.css ============================== -->
      <div class="ds-block">
        <h2>{L.gameUi.heading}</h2>
        <p class="ds-note">{L.gameUi.subhead}</p>

        <h3>{L.gameUi.chipsHeading}</h3>
        <div class="ds-row ds-chip-demo">
          <span class="ds-chip ds-chip-1">Jogador 1</span>
          <span class="ds-chip ds-chip-2">Jogador 2</span>
          <span class="ds-chip ds-chip-3">Jogador 3</span>
          <span class="ds-chip ds-chip-4">Jogador 4</span>
        </div>
        <p class="ds-note">{L.gameUi.chipsNote}</p>

        <h3>{L.gameUi.cardsHeading}</h3>
        <div class="ds-game-card-row">
          <div class="ds-game-card is-clickable">
            <img src="/design-system/bulbous-card-red.jpg" alt="" />
            <span class="ds-badge-circle">1</span>
            <div class="ds-game-card-bar">Bulbous</div>
          </div>
          <div class="ds-game-card is-clickable">
            <img src="/design-system/bulbous-card-blue.jpg" alt="" />
            <span class="ds-badge-circle">2</span>
            <div class="ds-game-card-bar">Bulbous</div>
          </div>
          <div class="ds-game-card is-clickable is-selected">
            <img src="/design-system/bulbous-card-green.jpg" alt="" />
            <span class="ds-badge-circle">3</span>
            <div class="ds-game-card-bar">Bulbous</div>
          </div>
          <div class="ds-game-card is-clickable">
            <img src="/design-system/bulbous-card-yellow.jpg" alt="" />
            <span class="ds-badge-circle">4</span>
            <div class="ds-game-card-bar">Bulbous</div>
          </div>
        </div>
        <p class="ds-note">{L.gameUi.cardsNote}</p>

        <h3>{L.gameUi.diceHeading}</h3>
        <div class="ds-dice-row">
          {sampleRoll.map((val) => (
            <div class="ds-die">
              {Array.from({ length: 9 }).map((_, i) => (
                <span class={`ds-dot ${DOTS[val].includes(i) ? "" : "ds-dot-off"}`}></span>
              ))}
            </div>
          ))}
        </div>
        <p class="ds-note">{L.gameUi.diceNote}</p>

        <div class="ds-two-col">
          <div>
            <h3>{L.gameUi.tabsHeading}</h3>
            <div class="ds-tabs">
              <button class="ds-tab active" data-ds-tab="a">Regras</button>
              <button class="ds-tab" data-ds-tab="b">Histórico</button>
            </div>
          </div>

          <div>
            <h3>{L.gameUi.toastHeading}</h3>
            <span class="ds-toast">{L.gameUi.modalTitle}</span>
          </div>
        </div>

        <h3>{L.gameUi.modalHeading}</h3>
        <p class="ds-note">{L.gameUi.modalNote}</p>
        <div class="ds-modal-box">
          <strong>{L.gameUi.modalTitle}</strong>
          <p>{L.gameUi.modalBody}</p>
          <button class="btn btn-primary">OK</button>
        </div>
      </div>

      <!-- ============================== jogos ============================== -->
      <div class="ds-block">
        <h2>{L.games.heading}</h2>
        <p class="ds-note">{L.games.subhead}</p>
        <div class="grid grid-4 ds-games-grid">
          {games.map((g) => (
            <div class="ds-game-item">
              <h3>{g.name}</h3>
              <p>{g.note}</p>
              <div class="ds-game-links">
                <a href={g.url} target="_blank" rel="noreferrer">{L.games.play} &rarr;</a>
                <a href={g.repo} target="_blank" rel="noreferrer">GitHub &rarr;</a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <p class="ds-footer-cta">
        <a href={`${REPO_URL}#readme`} target="_blank" rel="noreferrer">{L.footerCta}</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .ds-page :global(.section-head) {
    margin-bottom: 1.25rem;
  }

  .ds-hero-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .ds-intro {
    max-width: 74ch;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .ds-block {
    margin-bottom: 3rem;
  }

  .ds-block h2 {
    font-size: 1.5rem;
    margin-bottom: 0.35rem;
  }

  .ds-block h3 {
    font-size: 1rem;
    font-family: var(--font-display);
    color: var(--brand-primary);
    margin: 1.5rem 0 0.75rem;
  }

  .ds-skin-builder {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
  }

  .ds-skin-builder .ds-note {
    max-width: 60ch;
    margin-bottom: 1.1rem;
  }

  .ds-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    margin: 1rem 0 0.4rem;
  }

  .ds-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 68ch;
  }

  .ds-code {
    background: var(--color-ink);
    color: var(--color-cream);
    border-radius: var(--radius-md);
    padding: 0.9rem 1.1rem;
    overflow-x: auto;
    margin: 0 0 0.6rem;
  }

  .ds-code code {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.8rem;
    white-space: pre;
  }

  .ds-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .ds-swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
  }

  .ds-swatch {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ds-swatch-color {
    width: 100%;
    aspect-ratio: 1.6;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .ds-swatch code {
    font-size: 0.72rem;
    color: var(--text);
  }

  .ds-swatch span {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .ds-radius-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .ds-radius-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .ds-radius-box {
    width: 64px;
    height: 64px;
    background: var(--brand-primary);
  }

