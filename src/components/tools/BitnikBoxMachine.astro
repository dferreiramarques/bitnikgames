      netLabels: { base: "Base", tampa: "Lid" },
      fitsOneUpgraded: (name, w, h) =>
        `Fits whole on one ${name} sheet (${w}×${h}mm) — the smaller chosen preset wasn't enough, so it stepped up automatically.`,
      fitsOne: (name, w, h) => `Fits whole on one ${name} sheet (${w}×${h}mm). A single page, no need to join sheets.`,
      needsTiling: (cols, rows, name) =>
        `Even A0 isn't enough for a single page — splits into ${cols}×${rows} ${name} pages. Print them all, align using the overlap strips (in yellow), glue/tape the pages together, and only then cut the final outline (in orange).`,
