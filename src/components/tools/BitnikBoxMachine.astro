      printLegend: { cut: "cut (outline + corner relief)", fold: "fold" },
      overlapRight: "overlaps with sheet to the right",
      overlapBelow: "overlaps with sheet below",
      pageFooter: (label, row, col, rows, cols) => `${label} · page row ${row} col ${col} of ${rows}×${cols}`,
      summary: {
        baseInterior: "Base interior (calc.)",
