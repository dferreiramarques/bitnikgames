---
import Layout from "../../layouts/Layout.astro";
import { pathTo, type Locale } from "../../i18n/routes";
import { t } from "../../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).tools;
const otherLocale: Locale = locale === "pt" ? "en" : "pt";

const title = "Bitnik Box Machine";
const description =
  locale === "pt"
    ? "Gera o plano de corte a laser e o embrulho de impressão para uma caixa telescópica de jogo de tabuleiro, a partir das medidas que quiseres."
    : "Generates the laser-cut plan and the print wrap for a telescoping board game box, from whatever measurements you give it.";

// Textos estáticos da interface, em pt/en — os textos gerados dinamicamente
// pelo script (nomes de peças, resumo, notas) têm o seu próprio dicionário
// dentro do <script>, porque correm no browser e não têm acesso a `locale`
// vindo do frontmatter.
const STRINGS = {
  pt: {
    subtitle: "Gerador de caixa · corte a laser + impressão",
    dims: {
      legend: "Dimensões exteriores (caixa fechada)",
      length: "Comprimento",
      width: "Largura",
      help: "Tamanho exterior máximo da caixa fechada — é a tampa (a peça maior) que fica exatamente com estas medidas; a base é sempre mais pequena, o suficiente para caber lá dentro com a folga de deslize. O interior útil da base aparece calculado no resumo.",
    },
    material: {
      legend: "Material e corte",
      thickness: "Espessura do cartão",
      kerf: "Compensação de kerf",
      help: "Kerf = material que o feixe consome. Encolhe cada peça esse valor para compensar. Faz um corte de teste e ajusta.",
    },
    lid: {
      legend: "Tampa telescópica (estilo jogo de tabuleiro)",
      totalHeight: "Altura total fechada",
      paperThickness: "Espessura da folha impressa",
      gap: "Folga por lado",
      help: "A tampa é que é funda — desce até à mesa e cobre a base por completo, formando um paralelepípedo perfeito. A profundidade da base não se escolhe à parte: é a máxima que ainda cabe dentro da tampa fechada, ou seja altura da tampa − espessura do cartão − espessura da folha impressa que embrulha a base (essa camada de papel também ocupa espaço lá dentro). Vês o valor calculado no resumo.",
    },
    tabsGlue: {
      legend: "Abas de cola (cartão)",
      width: "Largura da aba",
      help: "Peças de cartão montadas com fita/cola nestas abas laterais. Linha tracejada no plano de corte marca a zona de fita — não é corte.",
    },
    laserSheet: {
      legend: "Folha do laser",
      preset: "Predefinição",
      custom: "Personalizado",
      width: "Largura",
      height: "Altura",
      margin: "Margem / espaço",
    },
    printSheet: {
      legend: "Folha de impressão (embrulho)",
      preset: "Folha mínima preferida",
      widthCustom: "Largura (personalizado)",
      heightCustom: "Altura (personalizado)",
      rim: "Aba de acabamento",
      corner: "Aba de canto",
      overlap: "Sobreposição entre folhas",
      help: "Uma única peça embrulha cada caixa já montada. Se não couber inteira na folha escolhida, a app ignora essa predefinição e sobe automaticamente para A2 / A1 / A0 até caber numa só página. Os cantos têm dois cortes especializados: um bisel oblíquo (~15°) onde a aba de canto encontra a dobra da base/topo — reforça esse ponto em vez de deixar um ângulo reto — e um corte em V onde a aba de acabamento do lado curto se cruza com a aba de canto. Sem curvas — só cortes retos em ângulo.",
    },
    mainTabs: { cut: "Plano de corte (laser)", print: "Plano de impressão (embrulho)" },
    actions: {
      dlCutCurrent: "Descarregar esta folha (SVG)",
      dlCutAll: "Descarregar todas as folhas (SVG)",
      dlPrintCurrent: "Descarregar esta página (SVG)",
      dlPrintAll: "Descarregar todas as páginas deste embrulho (SVG)",
    },
  },
  en: {
    subtitle: "Box generator · laser cut + print",
    dims: {
      legend: "Outer dimensions (closed box)",
      length: "Length",
      width: "Width",
      help: "Maximum outer size of the closed box — it's the lid (the larger piece) that matches these measurements exactly; the base is always smaller, just enough to slide inside with clearance. The base's usable interior is calculated in the summary.",
    },
    material: {
      legend: "Material and cutting",
      thickness: "Board thickness",
      kerf: "Kerf compensation",
      help: "Kerf = material the beam consumes. Shrinks each piece by this amount to compensate. Do a test cut and adjust.",
    },
    lid: {
      legend: "Telescoping lid (board game style)",
      totalHeight: "Total closed height",
      paperThickness: "Printed sheet thickness",
      gap: "Clearance per side",
      help: "The lid is the deep part — it comes down to the table and covers the base completely, forming a perfect rectangular box. The base's depth isn't chosen separately: it's the maximum that still fits inside the closed lid, i.e. lid height − board thickness − thickness of the printed sheet wrapping the base (that layer of paper also takes up space inside). See the calculated value in the summary.",
    },
    tabsGlue: {
      legend: "Glue tabs (board)",
      width: "Tab width",
      help: "Board pieces assembled with tape/glue on these side tabs. The dashed line in the cut plan marks the tape zone — it's not a cut.",
    },
    laserSheet: {
      legend: "Laser sheet",
      preset: "Preset",
      custom: "Custom",
      width: "Width",
      height: "Height",
      margin: "Margin / spacing",
    },
    printSheet: {
      legend: "Print sheet (wrap)",
      preset: "Preferred minimum sheet",
      widthCustom: "Width (custom)",
      heightCustom: "Height (custom)",
      rim: "Finishing flap",
      corner: "Corner flap",
      overlap: "Overlap between sheets",
      help: "A single piece wraps each assembled box. If it doesn't fit whole on the chosen sheet, the app ignores that preset and automatically steps up to A2 / A1 / A0 until it fits on one page. The corners have two specialized cuts: an angled bevel (~15°) where the corner flap meets the base/top fold — reinforcing that point instead of leaving a right angle — and a V-cut where the short side's finishing flap crosses the corner flap. No curves — only straight angled cuts.",
    },
    mainTabs: { cut: "Cut plan (laser)", print: "Print plan (wrap)" },
    actions: {
      dlCutCurrent: "Download this sheet (SVG)",
      dlCutAll: "Download all sheets (SVG)",
      dlPrintCurrent: "Download this page (SVG)",
      dlPrintAll: "Download all pages of this wrap (SVG)",
    },
  },
} as const;

const L = STRINGS[locale];
---

<Layout
  locale={locale}
  altPath={pathTo(otherLocale, "tools", "bitnik-box-machine")}
  title={title}
  description={description}
>
  <section class="section tool-page">
    <div class="container">
      <a class="back-link" href={pathTo(locale, "tools")}>&larr; {copy.backToTools}</a>

      <div class="section-head">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{title}</h1>
        <p>{description}</p>
      </div>

      <div class="bm-app" data-locale={locale}>
        <aside class="bm-panel">
          <div class="bm-panel-head">
            <strong>BITNIK BOX MACHINE</strong>
            <span>{L.subtitle}</span>
          </div>
          <div class="bm-divider"></div>

          <fieldset class="bm-fieldset">
            <legend>{L.dims.legend}</legend>
            <div class="bm-row"><label for="bm-ext-l">{L.dims.length}</label><input type="number" id="bm-ext-l" value="280" min="20" step="1" /></div>
            <div class="bm-row"><label for="bm-ext-w">{L.dims.width}</label><input type="number" id="bm-ext-w" value="280" min="20" step="1" /></div>
            <p class="bm-help">{L.dims.help}</p>
          </fieldset>

          <fieldset class="bm-fieldset">
            <legend>{L.material.legend}</legend>
            <div class="bm-row"><label for="bm-thickness">{L.material.thickness}</label><input type="number" id="bm-thickness" value="2" min="0.5" step="0.1" /></div>
            <div class="bm-row"><label for="bm-kerf">{L.material.kerf}</label><input type="number" id="bm-kerf" value="0.1" min="0" step="0.01" /></div>
            <p class="bm-help">{L.material.help}</p>
          </fieldset>

          <fieldset class="bm-fieldset">
            <legend>{L.lid.legend}</legend>
            <div class="bm-row"><label for="bm-total-h">{L.lid.totalHeight}</label><input type="number" id="bm-total-h" value="70" min="15" step="1" /></div>
            <div class="bm-row"><label for="bm-paper-thickness">{L.lid.paperThickness}</label><input type="number" id="bm-paper-thickness" value="0.3" min="0" step="0.05" /></div>
            <div class="bm-row"><label for="bm-gap">{L.lid.gap}</label><input type="number" id="bm-gap" value="0.4" min="0" step="0.05" /></div>
            <p class="bm-help">{L.lid.help}</p>
          </fieldset>

          <fieldset class="bm-fieldset">
            <legend>{L.tabsGlue.legend}</legend>
            <div class="bm-row"><label for="bm-tab-width">{L.tabsGlue.width}</label><input type="number" id="bm-tab-width" value="12" min="4" step="1" /></div>
            <p class="bm-help">{L.tabsGlue.help}</p>
          </fieldset>

          <div class="bm-divider"></div>

          <fieldset class="bm-fieldset">
            <legend>{L.laserSheet.legend}</legend>
            <div class="bm-row">
              <label for="bm-laser-preset">{L.laserSheet.preset}</label>
              <select id="bm-laser-preset">
                <option value="600x400">600 × 400 mm</option>
                <option value="900x600">900 × 600 mm</option>
                <option value="300x200">300 × 200 mm</option>
                <option value="custom">{L.laserSheet.custom}</option>
              </select>
            </div>
            <div class="bm-row"><label for="bm-laser-w">{L.laserSheet.width}</label><input type="number" id="bm-laser-w" value="600" min="100" /></div>
            <div class="bm-row"><label for="bm-laser-h">{L.laserSheet.height}</label><input type="number" id="bm-laser-h" value="400" min="100" /></div>
            <div class="bm-row"><label for="bm-cut-margin">{L.laserSheet.margin}</label><input type="number" id="bm-cut-margin" value="8" min="0" /></div>
          </fieldset>

          <fieldset class="bm-fieldset">
            <legend>{L.printSheet.legend}</legend>
            <div class="bm-row">
              <label for="bm-print-preset">{L.printSheet.preset}</label>
              <select id="bm-print-preset">
                <option value="210x297">A4 (210 × 297)</option>
                <option value="297x420" selected>A3 (297 × 420)</option>
                <option value="420x594">A2 (420 × 594)</option>
                <option value="594x841">A1 (594 × 841)</option>
                <option value="841x1189">A0 (841 × 1189)</option>
                <option value="custom">{L.laserSheet.custom}</option>
              </select>
            </div>
            <div class="bm-row"><label for="bm-print-w">{L.printSheet.widthCustom}</label><input type="number" id="bm-print-w" value="297" min="100" /></div>
            <div class="bm-row"><label for="bm-print-h">{L.printSheet.heightCustom}</label><input type="number" id="bm-print-h" value="420" min="100" /></div>
            <div class="bm-row"><label for="bm-rim-overlap">{L.printSheet.rim}</label><input type="number" id="bm-rim-overlap" value="15" min="5" step="1" /></div>
            <div class="bm-row"><label for="bm-corner-tab">{L.printSheet.corner}</label><input type="number" id="bm-corner-tab" value="10" min="3" step="1" /></div>
            <div class="bm-row"><label for="bm-tile-overlap">{L.printSheet.overlap}</label><input type="number" id="bm-tile-overlap" value="10" min="0" step="1" /></div>
            <p class="bm-help">{L.printSheet.help}</p>
          </fieldset>

          <div class="bm-summary" id="bm-summary"></div>
        </aside>

        <div class="bm-workspace">
          <div class="bm-tabs">
            <button data-tab="cut" class="active">{L.mainTabs.cut}</button>
            <button data-tab="print">{L.mainTabs.print}</button>
          </div>

          <div id="bm-cut-view" class="bm-view active">
            <div class="bm-chip-row" id="bm-cut-sheet-tabs"></div>
            <div class="bm-canvas-wrap" id="bm-cut-canvas"></div>
            <div class="bm-actions">
              <button class="btn btn-outline" id="bm-dl-cut-current">{L.actions.dlCutCurrent}</button>
              <button class="btn btn-outline" id="bm-dl-cut-all">{L.actions.dlCutAll}</button>
            </div>
            <div class="bm-titleblock" id="bm-cut-titleblock"></div>
          </div>

          <div id="bm-print-view" class="bm-view">
            <div class="bm-chip-row" id="bm-net-tabs"></div>
            <div class="bm-overview">
              <div class="bm-thumb" id="bm-net-thumb"></div>
              <p class="bm-note" id="bm-net-note"></p>
            </div>
            <div class="bm-chip-row" id="bm-print-sheet-tabs"></div>
            <div class="bm-canvas-wrap" id="bm-print-canvas"></div>
            <div class="bm-actions">
              <button class="btn btn-outline" id="bm-dl-print-current">{L.actions.dlPrintCurrent}</button>
              <button class="btn btn-outline" id="bm-dl-print-all">{L.actions.dlPrintAll}</button>
            </div>
            <div class="bm-titleblock" id="bm-print-titleblock"></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .tool-page :global(.section-head) {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
  }

  .bm-app {
    --bm-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 1.75rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .bm-app {
      grid-template-columns: 1fr;
    }
  }

  .bm-panel {
    background: var(--color-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.25rem 1.5rem;
    box-shadow: var(--shadow-card);
  }

  .bm-panel-head strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .bm-panel-head span {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .bm-divider {
    height: 1px;
    background: var(--border);
    margin: 1rem 0;
  }

  .bm-fieldset {
    border: none;
    margin: 0 0 0.9rem;
    padding: 0;
  }

  .bm-fieldset legend {
    font-family: var(--font-display);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-primary);
    margin-bottom: 0.6rem;
    padding: 0;
  }

  .bm-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.55rem;
  }

  .bm-row label {
    font-size: 0.82rem;
    color: var(--text-muted);
    flex: 1;
  }

  .bm-row input[type="number"] {
    width: 82px;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.5rem;
    font-family: var(--bm-mono);
    font-size: 0.82rem;
    text-align: right;
  }

  .bm-row input[type="number"]:focus-visible {
    border-color: var(--brand-primary);
  }

  .bm-row select {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.5rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    width: 100%;
  }

  .bm-help {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0.2rem 0 0.7rem;
  }

  .bm-summary {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    margin-top: 0.4rem;
  }

  .bm-summary :global(.srow) {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.78rem;
    padding: 0.2rem 0;
    color: var(--text-muted);
  }

  .bm-summary :global(.srow b) {
    color: var(--text);
    font-family: var(--bm-mono);
    font-weight: 600;
    text-align: right;
  }

  .bm-summary :global(.srow.warn-row) {
    color: var(--brand-primary);
    font-size: 0.74rem;
    line-height: 1.4;
  }

  .bm-summary :global(.warn) {
    color: var(--brand-primary);
  }

  .bm-workspace {
    min-width: 0;
  }

  .bm-tabs {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .bm-tabs button {
    background: none;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.88rem;
    padding: 0.6rem 1rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }

  .bm-tabs button.active {
    color: var(--brand-primary);
    border-bottom-color: var(--brand-primary);
  }

  .bm-view {
    display: none;
  }

  .bm-view.active {
    display: block;
  }

  .bm-chip-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .bm-chip-row :global(button) {
    background: var(--color-white);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-family: var(--bm-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .bm-chip-row :global(button.active) {
    color: var(--color-white);
    background: var(--color-brick);
    border-color: var(--color-brick);
    font-weight: 700;
  }

  .bm-chip-row :global(button.active.net-lid) {
    background: var(--color-orange);
    border-color: var(--color-orange);
  }

  .bm-canvas-wrap {
    background: var(--color-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.1rem;
    display: flex;
    justify-content: center;
    overflow: auto;
  }

  .bm-canvas-wrap :global(svg) {
    max-width: 100%;
    height: auto;
  }

  .bm-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .bm-titleblock {
    margin-top: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--bm-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .bm-titleblock :global(div) {
    padding: 0.55rem 0.9rem;
    border-right: 1px solid var(--border);
  }

  .bm-titleblock :global(div:last-child) {
    border-right: none;
  }

  .bm-titleblock :global(b) {
    display: block;
    font-family: var(--font-display);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-primary);
    margin-bottom: 0.15rem;
    font-weight: 700;
  }

  .bm-overview {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .bm-thumb {
    background: var(--color-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.6rem;
  }

  .bm-thumb :global(svg) {
    display: block;
  }

  .bm-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 34ch;
    margin: 0;
  }
</style>

<script is:inline define:vars={{ locale }}>
  /* --- design tokens locais (fonte: os tokens do site) --- */
  const COLORS = {
    bg: "#fffaf1",
    line: "#ecd6ac",
    grid: "#f3e4cb",
    cut: "#b8461f",
    print: "#ea7c2e",
    overlap: "#e8a93b",
    overlapWash: "rgba(232,169,59,0.16)",
    printWash: "rgba(234,124,46,0.08)",
    fold: "#5b4636",
    text: "#2b1b12",
    muted: "#5b4636",
  };

  /* --- dicionário de textos gerados dinamicamente pelo script --- */
  const DICT = {
    pt: {
      customSheetName: "Personalizado",
      panel: { bottom: "Fundo", front: "Frente", back: "Trás", sideL: "Lateral E", sideR: "Lateral D" },
      piece: { base: "Base", lid: "Tampa" },
      cutLegend: { cut: "corte", tape: "zona de fita/cola (não corta)" },
      sheetWord: "FOLHA",
      wrapLabel: { base: "BASE — embrulho", lid: "TAMPA — embrulho" },
      printLegend: { cut: "corte (contorno + alívio de canto)", fold: "dobra" },
      overlapRight: "sobrepõe com a folha à direita",
      overlapBelow: "sobrepõe com a folha abaixo",
      pageFooter: (label, row, col, rows, cols) => `${label} · página linha ${row} col ${col} de ${rows}×${cols}`,
      summary: {
        baseInterior: "Interior da base (calc.)",
        trayDepth: "Profundidade da bandeja (calc.)",
        baseOuter: "Base (bandeja) exterior",
        lidOuter: "Tampa exterior",
        totalHeight: "Altura total fechada",
        usableSpace: "Espaço útil p/ conteúdo",
        piecesToCut: "Peças a cortar",
        laserSheets: "Folhas de laser",
        baseWrap: "Embrulho base",
        lidWrap: "Embrulho tampa",
        warnHeight:
          "⚠ altura total pedida era baixa demais para sobrar profundidade de bandeja — subiu automaticamente",
        warnFootprint:
          "⚠ comprimento/largura pedidos eram pequenos demais para sobrar base — subiram automaticamente",
      },
      sheetTabPrefix: "Folha ",
      netTabPrefix: "Embrulho — ",
      netLabels: { base: "Base", tampa: "Tampa" },
      fitsOneUpgraded: (name, w, h) =>
        `Cabe inteira numa folha ${name} (${w}×${h}mm) — a predefinição mais pequena escolhida não chegava, por isso subiu automaticamente.`,
      fitsOne: (name, w, h) => `Cabe inteira numa folha ${name} (${w}×${h}mm). Uma só página, sem juntar folhas.`,
      needsTiling: (cols, rows, name) =>
        `Nem A0 chega para uma só página — divide-se em ${cols}×${rows} páginas ${name}. Imprime todas, alinha pelas faixas de sobreposição (a amarelo), cola/fita as páginas entre si e só depois recorta o contorno final (laranja).`,
      unfoldedSize: (w, h) => `Tamanho total desdobrado: ${w} × ${h} mm.`,
      titleblock: {
