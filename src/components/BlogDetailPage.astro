---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { pathTo, type Locale } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
  entry: CollectionEntry<"posts">;
  slug: string;
}

const { locale, entry, slug } = Astro.props;
const copy = t(locale).blog;
const nav = t(locale).nav;
const otherLocale: Locale = locale === "pt" ? "en" : "pt";
const { title, excerpt, readingMinutes, tags, publishedDate } = entry.data;
const { Content } = await render(entry);

const dateFormatted = publishedDate.toLocaleDateString(locale === "pt" ? "pt-PT" : "en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout locale={locale} altPath={pathTo(otherLocale, "blog", slug)} title={title} description={excerpt}>
  <article class="section detail">
    <div class="container detail-narrow">
      <a class="back-link" href={pathTo(locale, "blog")}>&larr; {nav.blog}</a>
      <p class="post-meta">{dateFormatted} · {readingMinutes} {copy.minRead}</p>
      <h1>{title}</h1>
      <p class="detail-lede">{excerpt}</p>

      {tags.length > 0 && (
        <ul class="detail-tags">
          {tags.map((tagName) => (
            <li>{tagName}</li>
          ))}
        </ul>
      )}

      <div class="detail-content">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .detail-narrow {
    max-width: 720px;
  }

  .back-link {
    margin-bottom: 1.5rem;
  }

  .post-meta {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .detail-content {
    font-size: 1.05rem;
  }
</style>
