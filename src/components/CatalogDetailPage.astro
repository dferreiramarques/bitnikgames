---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { pathTo, type Locale } from "../i18n/routes";
import { t } from "../i18n/ui";
import { hasCoverImage } from "../lib/coverImage";
import { youtubeEmbedUrl } from "../lib/youtube";

interface Props {
  locale: Locale;
  entry: CollectionEntry<"games">;
  slug: string;
}

const { locale, entry, slug } = Astro.props;
const copy = t(locale).catalog;
const badges = t(locale).badges;
const nav = t(locale).nav;
const otherLocale: Locale = locale === "pt" ? "en" : "pt";
const { title, shortDescription, players, duration, age, status, price, externalUrl, ctaLabel, tags, video, videoEmbed, paypalButtonId } =
  entry.data;
const { Content } = await render(entry);

const coverSrc = hasCoverImage(slug) ? `/cards/${slug}.png` : null;
// O botão da PayPal só aparece se o jogo tiver um paypalButtonId (ID do
// "PayPal Button" criado na conta Business, ver src/content/config.ts) —
// sem isso, cai no link/placeholder que já existia, sem partir nada. É o
// export "single button" da PayPal (form estático a fazer POST para
// ncp/payment/<id>), não o widget "Hosted Buttons" com SDK — não precisa
// de client-id nem de script.
const paypalReady = status === "buy-now" && Boolean(paypalButtonId);
// Só usa o embed se videoEmbed:true E o link for reconhecível como
// YouTube — caso contrário cai sempre para o link simples, para nunca
// mostrar uma caixa de vídeo vazia.
const videoEmbedSrc = video && videoEmbed ? youtubeEmbedUrl(video) : null;
---

<Layout
  locale={locale}
  altPath={pathTo(otherLocale, "catalog", slug)}
  title={title}
  description={shortDescription}
>
  <article class="section detail">
    <div class="container detail-grid">
      <div class="detail-media-col detail-sticky">
        <div class="detail-media" aria-hidden="true">
          {coverSrc ? <img src={coverSrc} alt="" /> : title}
        </div>

        {video && (
          videoEmbedSrc ? (
            <div class="detail-video">
              <iframe
                src={videoEmbedSrc}
                title={title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          ) : (
            <a class="video-link" href={video} target="_blank" rel="noreferrer">▶ {copy.watchTrailer}</a>
          )
        )}
      </div>

      <div class="detail-body">
        <a class="back-link" href={pathTo(locale, "catalog")}>&larr; {nav.catalog}</a>
        <h1>{title}</h1>
        <p class="detail-lede">{shortDescription}</p>

        {(players || duration || age) && (
          <ul class="detail-meta">
            {players && (
              <li>
                <strong>{players.min === players.max ? players.min : `${players.min}–${players.max}`}</strong> {copy.players}
              </li>
            )}
            {duration && (
              <li><strong>{duration}</strong> {copy.duration}</li>
            )}
            {age && (
              <li><strong>{age} {copy.age}</strong></li>
            )}
          </ul>
        )}

        {tags.length > 0 && (
          <ul class="detail-tags">
            {tags.map((tagName) => (
              <li>{tagName}</li>
            ))}
          </ul>
        )}

        <div class="detail-cta">
          {paypalReady && (
            <form action={`https://www.paypal.com/ncp/payment/${paypalButtonId}`} method="post" target="_blank">
              <button class="btn btn-primary" type="submit">
                {ctaLabel ?? badges.buyNow} {price ? `· ${price}` : null}
              </button>
            </form>
          )}
          {status === "buy-now" && !paypalReady && externalUrl && (
            <a class="btn btn-primary" href={externalUrl} target="_blank" rel="noreferrer">
              {ctaLabel ?? badges.buyNow} {price ? `· ${price}` : null}
            </a>
          )}
          {status === "buy-now" && !paypalReady && !externalUrl && (
            <button class="btn btn-primary" type="button" disabled title={copy.checkoutPlaceholder}>
              {ctaLabel ?? badges.buyNow} {price ? `· ${price}` : null}
            </button>
          )}
          {status === "buy-external" && externalUrl && (
            <a class="btn btn-primary" href={externalUrl} target="_blank" rel="noreferrer">
              {ctaLabel ?? badges.buyExternal}
            </a>
          )}
          {status === "coming-soon" && (
            <span class="btn btn-outline" aria-disabled="true">{ctaLabel ?? badges.comingSoon}</span>
          )}
        </div>

        <div class="detail-content">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Layout>
