---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Badge from "./Badge.astro";
import { pathTo, type Locale } from "../i18n/routes";
import { t } from "../i18n/ui";
import { pnpBadge } from "../lib/badges";
import { hasCoverImage } from "../lib/coverImage";

interface Props {
  locale: Locale;
  entry: CollectionEntry<"pnp">;
  slug: string;
}

const { locale, entry, slug } = Astro.props;
const copy = t(locale).pnp;
const nav = t(locale).nav;
const otherLocale: Locale = locale === "pt" ? "en" : "pt";
const { title, shortDescription, access, price, fileUrl, externalUrl, externalLabel, players, duration, tags } =
  entry.data;
const { Content } = await render(entry);

const badge = pnpBadge(locale, access, price);
const fileReady = fileUrl !== "#";
const coverSrc = hasCoverImage(slug) ? `/cards/${slug}.png` : null;
---

<Layout
  locale={locale}
  altPath={pathTo(otherLocale, "printAndPlay", slug)}
  title={title}
  description={shortDescription}
>
  <article class="section detail">
    <div class="container detail-grid">
      <div class="detail-media" aria-hidden="true">
        {coverSrc ? <img src={coverSrc} alt="" /> : title}
      </div>

      <div class="detail-body">
        <a class="back-link" href={pathTo(locale, "printAndPlay")}>&larr; {nav.printAndPlay}</a>
        <Badge variant={badge.variant} label={badge.label} />
        <h1>{title}</h1>
        <p class="detail-lede">{shortDescription}</p>

        {(players || duration) && (
          <ul class="detail-meta">
            {players && (
              <li>
                <strong>{players.min === players.max ? players.min : `${players.min}–${players.max}`}</strong> {copy.players}
              </li>
            )}
            {duration && (
              <li><strong>{duration}</strong> {copy.duration}</li>
            )}
          </ul>
        )}

        {tags.length > 0 && (
          <ul class="detail-tags">
            {tags.map((tagName) => (
              <li>{tagName}</li>
            ))}
          </ul>
        )}

        <div class="detail-cta">
          {externalUrl ? (
            <a class="btn btn-primary" href={externalUrl} target="_blank" rel="noreferrer">
              {externalLabel ?? copy.buyExternal}
            </a>
          ) : fileReady ? (
            <a class="btn btn-primary" href={fileUrl} download>
              {copy.download}
            </a>
          ) : (
            <button class="btn btn-primary" type="button" disabled title={copy.downloadPlaceholder}>
              {copy.download}
            </button>
          )}
        </div>

        <div class="detail-content">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Layout>
