---
import type { CollectionEntry } from "astro:content";
import Badge from "./Badge.astro";
import { pathTo, type Locale } from "../i18n/routes";
import { entryBadge } from "../lib/badges";
import { hasCoverImage } from "../lib/coverImage";

interface Props {
  locale: Locale;
  item: CollectionEntry<"pnp">;
  slug: string;
}

const { locale, item, slug } = Astro.props;
const { title, shortDescription, status, price } = item.data;

const badge = entryBadge(locale, status, price);
const href = pathTo(locale, "printAndPlay", slug);
const coverSrc = hasCoverImage(slug) ? `/cards/${slug}.png` : null;
---

<a class="card" href={href}>
  <div class="card-media" aria-hidden="true">
    {coverSrc ? <img src={coverSrc} alt="" /> : title}
  </div>
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    <p class="card-excerpt">{shortDescription}</p>
    <div class="card-footer">
      <Badge variant={badge.variant} label={badge.label} />
    </div>
  </div>
</a>
