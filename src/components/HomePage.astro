---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import GameCard from "./GameCard.astro";
import PnpCard from "./PnpCard.astro";
import PostCard from "./PostCard.astro";
import { pathTo, type Locale } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).home;
const otherLocale: Locale = locale === "pt" ? "en" : "pt";

// Se houver entradas marcadas featured:true (checkbox "Destacar na
// homepage" no CMS), mostra essas; caso contrário, cai para as mais
// recentes por publishedDate — nunca uma secção vazia por ninguém ainda
// ter escolhido nada.
function pickFeatured<T extends { data: { featured?: boolean; publishedDate: Date } }>(entries: T[]): T[] {
  const byRecency = [...entries].sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
  const featured = byRecency.filter((e) => e.data.featured);
  return (featured.length > 0 ? featured : byRecency).slice(0, 3);
}

const allGames = await getCollection("games", ({ id }) => id.startsWith(`${locale}/`));
const featuredGames = pickFeatured(allGames);

const allPnp = await getCollection("pnp", ({ id }) => id.startsWith(`${locale}/`));
const featuredPnp = pickFeatured(allPnp);

const allPosts = await getCollection("posts", ({ id }) => id.startsWith(`${locale}/`));
const latestPosts = pickFeatured(allPosts);

const slugOf = (id: string) => id.split("/").slice(1).join("/");
---

<Layout locale={locale} altPath={pathTo(otherLocale, "home")} title={copy.title} description={copy.subtitle}>
  <section class="hero">
    <div class="container hero-row">
      <div class="hero-inner">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.title}</h1>
        <p class="hero-subtitle">{copy.subtitle}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={pathTo(locale, "catalog")}>{copy.ctaCatalog}</a>
          <a class="btn btn-outline" href={pathTo(locale, "printAndPlay")}>{copy.ctaPnp}</a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hero-glow"></div>

        <div class="piece-orbit piece-die">
          <div class="piece-face piece-die-face">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>

        <div class="piece-orbit piece-card">
          <img class="piece-face piece-character piece-character-lg" src="/characters/capivaras.png" alt="" width="124" height="101" />
        </div>

        <div class="piece-orbit piece-hex">
          <div class="piece-face piece-hex-face"></div>
        </div>

        <div class="piece-orbit piece-coin">
          <img class="piece-face piece-character" src="/characters/pink-monster.png" alt="" width="78" height="87" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.gamesEyebrow}</span>
        <h2>{copy.gamesTitle}</h2>
        <p>{copy.gamesSubtitle}</p>
      </div>
      <div class="grid grid-3">
        {featuredGames.map((game) => (
          <GameCard locale={locale} game={game} slug={slugOf(game.id)} />
        ))}
      </div>
      <div class="section-cta">
        <a class="btn btn-outline" href={pathTo(locale, "catalog")}>{copy.gamesCta}</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.pnpEyebrow}</span>
        <h2>{copy.pnpTitle}</h2>
        <p>{copy.pnpSubtitle}</p>
      </div>
      <div class="grid grid-3">
        {featuredPnp.map((item) => (
          <PnpCard locale={locale} item={item} slug={slugOf(item.id)} />
        ))}
      </div>
      <div class="section-cta">
        <a class="btn btn-outline" href={pathTo(locale, "printAndPlay")}>{copy.pnpCta}</a>
      </div>
    </div>
  </section>

  <section class="section play-online">
    <div class="container play-online-inner">
      <div class="section-head play-online-head">
        <span class="eyebrow">{copy.playOnlineEyebrow}</span>
        <h2>{copy.playOnlineTitle}</h2>
        <p>{copy.playOnlineSubtitle}</p>
      </div>
      <a class="btn btn-outline" href={pathTo(locale, "playOnline")}>{copy.playOnlineCta}</a>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.blogEyebrow}</span>
        <h2>{copy.blogTitle}</h2>
        <p>{copy.blogSubtitle}</p>
      </div>
      <div class="grid grid-3">
        {latestPosts.map((post) => (
          <PostCard locale={locale} post={post} slug={slugOf(post.id)} />
        ))}
      </div>
      <div class="section-cta">
        <a class="btn btn-outline" href={pathTo(locale, "blog")}>{copy.blogCta}</a>
      </div>
    </div>
  </section>

  <section class="newsletter">
    <div class="container newsletter-inner">
      <div>
        <h2>{copy.newsletterTitle}</h2>
        <p>{copy.newsletterSubtitle}</p>
      </div>
      <form
        class="newsletter-form"
        id="newsletter-form"
        data-success-message={copy.newsletterSuccess}
        action="https://buttondown.com/api/emails/embed-subscribe/bitnikgames"
        method="post"
        target="popupwindow"
      >
        <label class="visually-hidden" for="newsletter-email">Email</label>
        <input id="newsletter-email" name="email" type="email" required placeholder={copy.newsletterPlaceholder} />
        <input type="hidden" name="embed" value="1" />
        <button class="btn btn-secondary" type="submit">{copy.newsletterCta}</button>
      </form>
      <p class="newsletter-success" id="newsletter-success" role="status" hidden></p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4rem);
    background: radial-gradient(circle at top right, var(--color-cream-soft), var(--bg) 60%);
    overflow: hidden;
  }

  .hero-row {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    flex-wrap: wrap;
  }

  .hero-inner {
    max-width: 620px;
    flex: 1 1 380px;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-primary);
    margin-bottom: 0.75rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 60ch;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  /* --- hero visual: peças de jogo placeholder, à espera de ilustração --- */

  .hero-visual {
    position: relative;
    width: min(460px, 82vw);
    aspect-ratio: 1;
    flex: 0 0 auto;
    margin-inline: auto;
  }

  .hero-glow {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-yellow) 0%, var(--color-orange) 45%, transparent 72%);
    filter: blur(36px);
    opacity: 0.4;
    animation: hero-pulse 7s ease-in-out infinite;
  }

  .piece-orbit {
    position: absolute;
    animation: hero-float 6s ease-in-out infinite;
  }

  .piece-die {
    top: 4%;
    left: 6%;
    animation-duration: 5.5s;
  }

  .piece-card {
    top: 18%;
    right: -6%;
    animation-duration: 7s;
    animation-delay: -2.3s;
  }

  .piece-hex {
    bottom: 8%;
    left: 18%;
    animation-duration: 6.5s;
    animation-delay: -4.1s;
  }

  .piece-coin {
    bottom: 0;
    right: 24%;
    animation-duration: 5s;
    animation-delay: -1.2s;
  }

  .piece-face {
    box-shadow: var(--shadow-card-hover);
  }

  .piece-die-face {
    width: 88px;
    height: 88px;
    padding: 13px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-ink) 0%, var(--color-ink-soft) 100%);
    transform: rotate(-9deg);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 4px;
  }

  .piece-die-face span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-cream);
  }

  .piece-die-face span:nth-child(1) {
    grid-area: 1 / 1;
  }

  .piece-die-face span:nth-child(2) {
    grid-area: 1 / 3;
  }

  .piece-die-face span:nth-child(3) {
    grid-area: 2 / 2;
  }

  .piece-die-face span:nth-child(4) {
    grid-area: 3 / 1;
  }

  .piece-die-face span:nth-child(5) {
    grid-area: 3 / 3;
  }

  .piece-hex-face {
    width: 96px;
    height: 96px;
    background: linear-gradient(160deg, var(--color-orange), var(--color-brick));
    clip-path: polygon(25% 4%, 75% 4%, 100% 50%, 75% 96%, 25% 96%, 0% 50%);
    transform: rotate(-5deg);
  }

  .piece-character.piece-character-lg {
    width: min(372px, 68vw);
  }

  .piece-character {
    width: 78px;
    height: auto;
    box-shadow: none;
    filter: drop-shadow(0 4px 6px rgba(43, 27, 18, 0.14));
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-14px);
    }
  }

  @keyframes hero-pulse {
    0%,
    100% {
      opacity: 0.32;
      transform: scale(1);
    }
    50% {
      opacity: 0.48;
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .piece-orbit,
    .hero-glow {
      animation: none;
    }
  }

  @media (max-width: 600px) {
    .hero-visual {
      width: min(300px, 78vw);
    }
  }

  .section-alt {
    background: var(--bg-alt);
  }

  .section-cta {
    margin-top: 2rem;
  }

  .play-online-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .play-online-head {
    margin-bottom: 0;
  }

  .newsletter {
    background: linear-gradient(120deg, var(--color-brick) 0%, var(--color-brick-deep) 45%, var(--color-orange) 80%, var(--color-yellow) 100%);
    color: var(--color-white);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .newsletter h2 {
    color: var(--color-white);
    text-shadow: 0 1px 3px rgba(43, 27, 18, 0.35);
  }

  .newsletter p {
    color: color-mix(in srgb, var(--color-white) 92%, transparent);
    text-shadow: 0 1px 3px rgba(43, 27, 18, 0.3);
  }

  .newsletter-success {
    margin-top: 0.75rem;
    font-weight: 600;
    text-shadow: 0 1px 3px rgba(43, 27, 18, 0.3);
  }

  .newsletter-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .newsletter-inner > div {
    max-width: 480px;
  }

  .newsletter-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .newsletter-form input {
    font-family: var(--font-body);
    padding: 0.7rem 1rem;
    border-radius: var(--radius-pill);
    border: none;
    min-width: 240px;
  }
</style>

<script>
  // Newsletter via Buttondown (buttondown.com/bitnikgames): o <form> submete
  // a sério, diretamente do browser para o Buttondown — sem backend próprio,
  // sem chave de API para esconder. A confirmação (double opt-in) acontece
  // numa janela pequena; mostramos uma nota inline também, para quem tem
  // pop-ups bloqueados.
  const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
  const success = document.getElementById("newsletter-success");

  form?.addEventListener("submit", () => {
    window.open("", "popupwindow", "width=480,height=520");
    if (success) {
      success.textContent = form.dataset.successMessage ?? "";
      success.hidden = false;
    }
  });
</script>
