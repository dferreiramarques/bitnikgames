---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import GameCard from "./GameCard.astro";
import PnpCard from "./PnpCard.astro";
import PostCard from "./PostCard.astro";
import { pathTo, type Locale } from "../i18n/routes";
import { t } from "../i18n/ui";
import { sortEntries } from "../lib/sortEntries";
import { getPublished } from "../lib/getPublished";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).home;
const otherLocale: Locale = locale === "pt" ? "en" : "pt";

// Se houver entradas marcadas featured:true (checkbox "Destacar na
// homepage" no CMS), mostra essas — na ordem manual escolhida no CMS
// (drag-and-drop), com mais recente como desempate; caso contrário, cai
// para sortEntries() normal — nunca uma secção vazia por ninguém ainda
// ter escolhido nada.
function pickFeatured<T extends { data: { featured?: boolean; order?: number; publishedDate: Date } }>(
  entries: T[]
): T[] {
  const ordered = sortEntries(entries);
  const featured = ordered.filter((e) => e.data.featured);
  return (featured.length > 0 ? featured : ordered).slice(0, 3);
}

const allGames = await getPublished("games", locale);
const featuredGames = pickFeatured(allGames);

const allPnp = await getPublished("pnp", locale);
const featuredPnp = pickFeatured(allPnp);

const allPosts = await getPublished("posts", locale);
const latestPosts = pickFeatured(allPosts);

const slugOf = (id: string) => id.split("/").slice(1).join("/");

// Texto do hero vem do CMS (coleção "hero", entrada única "home") — cai
// para src/i18n/ui.ts se essa entrada ainda não existir, para nunca partir
// o build por falta de conteúdo.
const heroEntry = await getEntry("hero", `${locale}/home`);
const hero = heroEntry?.data ?? { eyebrow: copy.eyebrow, title: copy.title, subtitle: copy.subtitle };
---

<Layout locale={locale} altPath={pathTo(otherLocale, "home")} title={hero.title} description={hero.subtitle}>
  <section class="hero">
    <div class="container hero-row">
      <div class="hero-inner">
        <span class="eyebrow">{hero.eyebrow}</span>
        <h1>{hero.title}</h1>
        <p class="hero-subtitle">{hero.subtitle}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={pathTo(locale, "catalog")}>{copy.ctaCatalog}</a>
          <a class="btn btn-outline" href={pathTo(locale, "printAndPlay")}>{copy.ctaPnp}</a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hero-glow"></div>

        <div class="piece-orbit piece-die">
          <div class="piece-avoid">
            <img class="piece-face piece-character" src="/characters/bulbous.png" alt="" width="176" height="170" />
          </div>
        </div>

        <div class="piece-orbit piece-card">
          <div class="piece-avoid">
            <img class="piece-face piece-character piece-character-lg" src="/characters/capivaras.png" alt="" width="124" height="101" />
          </div>
        </div>

        <div class="piece-orbit piece-hex">
          <div class="piece-avoid">
            <img class="piece-face piece-character" src="/characters/zombiequerque.png" alt="" width="117" height="104" />
          </div>
        </div>

        <div class="piece-orbit piece-coin">
          <div class="piece-avoid">
            <img class="piece-face piece-character" src="/characters/pink-monster.png" alt="" width="78" height="87" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.gamesEyebrow}</span>
        <h2>{copy.gamesTitle}</h2>
        <p>{copy.gamesSubtitle}</p>
      </div>
      <div class="grid grid-3">
        {featuredGames.map((game) => (
          <GameCard locale={locale} game={game} slug={slugOf(game.id)} />
        ))}
      </div>
      <div class="section-cta">
        <a class="btn btn-outline" href={pathTo(locale, "catalog")}>{copy.gamesCta}</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.pnpEyebrow}</span>
        <h2>{copy.pnpTitle}</h2>
        <p>{copy.pnpSubtitle}</p>
      </div>
      <div class="grid grid-3">
        {featuredPnp.map((item) => (
          <PnpCard locale={locale} item={item} slug={slugOf(item.id)} />
        ))}
      </div>
      <div class="section-cta">
        <a class="btn btn-outline" href={pathTo(locale, "printAndPlay")}>{copy.pnpCta}</a>
      </div>
    </div>
  </section>

  <section class="section play-online">
    <div class="container play-online-inner">
      <div class="section-head play-online-head">
        <span class="eyebrow">{copy.playOnlineEyebrow}</span>
        <h2>{copy.playOnlineTitle}</h2>
        <p>{copy.playOnlineSubtitle}</p>
      </div>
      <a class="btn btn-outline" href={pathTo(locale, "playOnline")}>{copy.playOnlineCta}</a>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.blogEyebrow}</span>
        <h2>{copy.blogTitle}</h2>
        <p>{copy.blogSubtitle}</p>
      </div>
      <div class="grid grid-3">
        {latestPosts.map((post) => (
          <PostCard locale={locale} post={post} slug={slugOf(post.id)} />
        ))}
      </div>
      <div class="section-cta">
        <a class="btn btn-outline" href={pathTo(locale, "blog")}>{copy.blogCta}</a>
      </div>
    </div>
  </section>

  <section class="newsletter">
    <div class="container newsletter-inner">
      <div>
        <h2>{copy.newsletterTitle}</h2>
        <p>{copy.newsletterSubtitle}</p>
      </div>
      <form
        class="newsletter-form"
        id="newsletter-form"
        data-success-message={copy.newsletterSuccess}
        action="https://buttondown.com/api/emails/embed-subscribe/bitnikgames"
        method="post"
        target="popupwindow"
      >
        <label class="visually-hidden" for="newsletter-email">Email</label>
        <input id="newsletter-email" name="email" type="email" required placeholder={copy.newsletterPlaceholder} />
        <input type="hidden" name="embed" value="1" />
        <button class="btn btn-secondary" type="submit">{copy.newsletterCta}</button>
      </form>
      <p class="newsletter-success" id="newsletter-success" role="status" hidden></p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(2.25rem, 5vw, 3.75rem) clamp(1.75rem, 4vw, 2.75rem);
    background: radial-gradient(circle at top right, var(--color-white), var(--bg) 60%);
    overflow: hidden;
  }

  .hero-row {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    flex-wrap: wrap;
  }

  .hero-inner {
    max-width: 620px;
    flex: 1 1 380px;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-primary);
    margin-bottom: 0.75rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 60ch;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  /* --- hero visual: peças de jogo placeholder, à espera de ilustração --- */

  .hero-visual {
    position: relative;
    width: min(380px, 72vw);
    aspect-ratio: 1;
    flex: 0 0 auto;
    margin-inline: auto;
  }

  .hero-glow {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-yellow) 0%, var(--color-orange) 45%, transparent 72%);
    filter: blur(36px);
    opacity: 0.4;
    animation: hero-pulse 7s ease-in-out infinite;
  }

  .piece-orbit {
    position: absolute;
    animation: hero-float 6s ease-in-out infinite;
  }

  /* Deslocamento de "fuga ao rato" (ver o script mais abaixo) — fica num
     filho à parte para não entrar em conflito com o transform do float
     acima; a curva com overshoot é o que dá o ar elástico ao ir e voltar. */
  .piece-avoid {
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform;
  }

  .piece-die {
    top: 4%;
    left: 6%;
    animation-duration: 5.5s;
  }

  .piece-card {
    top: 18%;
    right: -6%;
    animation-duration: 7s;
    animation-delay: -2.3s;
  }

  .piece-hex {
    bottom: 8%;
    left: 18%;
    animation-duration: 6.5s;
    animation-delay: -4.1s;
  }

  .piece-coin {
    bottom: 0;
    right: 24%;
    animation-duration: 5s;
    animation-delay: -1.2s;
  }

  .piece-face {
    box-shadow: var(--shadow-card-hover);
  }

  .piece-character.piece-character-lg {
    width: min(372px, 68vw);
  }

  .piece-die .piece-character {
    width: 156px;
  }

  .piece-hex .piece-character {
    width: 117px;
  }

  .piece-character {
    width: 78px;
    height: auto;
    box-shadow: none;
    filter: drop-shadow(0 4px 6px rgba(43, 27, 18, 0.14));
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-14px);
    }
  }

  @keyframes hero-pulse {
    0%,
    100% {
      opacity: 0.32;
      transform: scale(1);
    }
    50% {
      opacity: 0.48;
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .piece-orbit,
    .hero-glow {
      animation: none;
    }

    .piece-avoid {
      transition: none;
    }
  }

  @media (max-width: 600px) {
    .hero-visual {
      width: min(260px, 74vw);
      aspect-ratio: 13 / 10;
    }

    /* Aos tamanhos do desktop, as personagens quase enchem sozinhas este
       contentor mais pequeno e ficam empilhadas — encolhem também aqui,
       mantendo proporções semelhantes entre si. */
    .piece-character.piece-character-lg {
      width: min(180px, 50vw);
    }

    .piece-die .piece-character {
      width: 100px;
    }

    .piece-hex .piece-character {
      width: 76px;
    }

    .piece-coin .piece-character {
      width: 52px;
    }
  }

  .section-alt {
    background: var(--bg-alt);
  }

  .section-cta {
    margin-top: 2rem;
  }

  .play-online-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .play-online-head {
    margin-bottom: 0;
  }

  .newsletter {
    background: linear-gradient(120deg, var(--color-brick) 0%, var(--color-brick-deep) 45%, var(--color-orange) 80%, var(--color-yellow) 100%);
    color: var(--color-white);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .newsletter h2 {
    color: var(--color-white);
    text-shadow: 0 1px 3px rgba(43, 27, 18, 0.35);
  }

  .newsletter p {
    color: color-mix(in srgb, var(--color-white) 92%, transparent);
    text-shadow: 0 1px 3px rgba(43, 27, 18, 0.3);
  }

  .newsletter-success {
    margin-top: 0.75rem;
    font-weight: 600;
    text-shadow: 0 1px 3px rgba(43, 27, 18, 0.3);
  }

  .newsletter-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .newsletter-inner > div {
    max-width: 480px;
  }

  .newsletter-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .newsletter-form input {
    font-family: var(--font-body);
    padding: 0.7rem 1rem;
    border-radius: var(--radius-pill);
    border: none;
    min-width: 240px;
  }
</style>

<script>
  // Newsletter via Buttondown (buttondown.com/bitnikgames): o <form> submete
  // a sério, diretamente do browser para o Buttondown — sem backend próprio,
  // sem chave de API para esconder. A confirmação (double opt-in) acontece
  // numa janela pequena; mostramos uma nota inline também, para quem tem
  // pop-ups bloqueados.
  const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
  const success = document.getElementById("newsletter-success");

  form?.addEventListener("submit", () => {
    window.open("", "popupwindow", "width=480,height=520");
    if (success) {
      success.textContent = form.dataset.successMessage ?? "";
      success.hidden = false;
    }
  });
</script>

<script>
  // Peças do hero fogem ao cursor: cada .piece-avoid recebe um translate()
  // que aponta para longe do rato quando este se aproxima, e volta a (0, 0)
  // assim que o rato se afasta — o "elástico" vem da transition com
  // overshoot definida em .piece-avoid (CSS), não de física em JS. O CSS
  // já trata do bobbing (.piece-orbit); isto vive num filho à parte para os
  // dois transforms não pisarem um no outro.
  const pieces = Array.from(document.querySelectorAll<HTMLElement>(".hero-visual .piece-avoid"));
  const canHover = window.matchMedia("(pointer: fine)").matches;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (pieces.length > 0 && canHover && !reduceMotion) {
    const RADIUS = 150; // px a partir do centro da peça — só reage perto
    const MAX_PUSH = 100; // px — deslocamento máximo pedido

    let pointer: { x: number; y: number } | null = null;
    let rafId: number | null = null;

    function render() {
      rafId = null;
      for (const piece of pieces) {
        if (!pointer) {
          piece.style.transform = "";
          continue;
        }
        const rect = piece.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = cx - pointer.x;
        const dy = cy - pointer.y;
        const dist = Math.hypot(dx, dy) || 0.001;
        if (dist >= RADIUS) {
          piece.style.transform = "";
          continue;
        }
        const strength = (1 - dist / RADIUS) * MAX_PUSH;
        const nx = (dx / dist) * strength;
        const ny = (dy / dist) * strength;
        piece.style.transform = `translate(${nx.toFixed(1)}px, ${ny.toFixed(1)}px)`;
      }
    }

    function schedule() {
      if (rafId === null) rafId = requestAnimationFrame(render);
    }

    window.addEventListener(
      "mousemove",
      (e) => {
        pointer = { x: e.clientX, y: e.clientY };
        schedule();
      },
      { passive: true }
    );

    document.documentElement.addEventListener("mouseleave", () => {
      pointer = null;
      schedule();
    });
  }
</script>
