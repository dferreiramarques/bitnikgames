---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { pathTo, type Locale } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).playOnline;
const otherLocale: Locale = locale === "pt" ? "en" : "pt";

// Cartões geridos no CMS (coleção "playOnline") — cada jogo corre no seu
// próprio servidor (jogos em tempo real precisam de mais do que ficheiros
// estáticos), por isso "url" é sempre um link externo, nunca uma rota
// interna do site.
const games = (await getCollection("playOnline", ({ id }) => id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout locale={locale} altPath={pathTo(otherLocale, "playOnline")} title={copy.title} description={copy.subtitle}>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.title}</h1>
        <p>{copy.subtitle}</p>
      </div>

      {games.length > 0 ? (
        <div class="grid grid-3">
          {games.map((game) => (
            <div class="card play-card">
              <div class="card-body">
                <h3 class="card-title">{game.data.title}</h3>
                <p class="card-excerpt">{game.data.description}</p>
              </div>
              <a class="btn btn-primary btn-block" href={game.data.url} target="_blank" rel="noreferrer">
                {copy.openGame} &rarr;
              </a>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <span class="badge badge-soon">{"⏳"}</span>
          <div>
            <h2>{copy.comingSoonTitle}</h2>
            <p>{copy.comingSoonBody}</p>
          </div>
        </div>
      )}

      <p class="external-note">{copy.externalNote}</p>
    </div>
  </section>
</Layout>

<style>
  .play-card {
    padding: 1.1rem 1.25rem 1.25rem;
    gap: 0.6rem;
  }

  .play-card .card-body {
    padding: 0;
  }

  .external-note {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .empty-state {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 640px;
    padding: 2rem;
    background: var(--bg-alt);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }

  .empty-state .badge {
    font-size: 1.1rem;
    padding: 0.55rem 0.7rem;
  }

  .empty-state h2 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .empty-state p {
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 500px) {
    .empty-state {
      flex-direction: column;
    }
  }
</style>
