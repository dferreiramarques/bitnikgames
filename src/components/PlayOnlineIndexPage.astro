---
import Layout from "../layouts/Layout.astro";
import { pathTo, type Locale } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).playOnline;
const otherLocale: Locale = locale === "pt" ? "en" : "pt";

// Registo simples dos jogos disponíveis para jogar online. Cada um corre
// no seu próprio servidor (jogos em tempo real precisam de mais do que
// ficheiros estáticos) — por isso o link é sempre externo, nunca uma
// rota interna do site. Quando houver mais do que um jogo, isto passa a
// listar vários cartões sem precisar de mudar mais nada aqui.
const games = [
  {
    title: "Bulbous",
    url: "https://bulbous.up.railway.app/",
    accentFrom: "#c084fc",
    accentTo: "#2e2e50",
    description: {
      pt: "Sorte, bluff e estratégia — multijogador em tempo real, até 4 jogadores ou contra bots.",
      en: "Luck, bluff, and strategy — realtime multiplayer for up to 4 players, or against bots.",
    },
  },
  {
    title: "Capivaras",
    url: "https://capivaras.up.railway.app/",
    accentFrom: "#c47c28",
    accentTo: "#3a9e96",
    description: {
      pt: "Aposta em silêncio para conquistar as capivaras do Pantanal — quem escolher a mesma que outro jogador fica a ver navios.",
      en: "Bet in silence to win over the Pantanal's capybaras — pick the same one as another player and they both scare it off.",
    },
  },
  {
    title: "Catania",
    url: "https://catania.up.railway.app/",
    accentFrom: "#c9a84c",
    accentTo: "#2a1f08",
    description: {
      pt: "Gestão de recursos na Sicília do Século VIII a.C. — recolhe cereais, vinho e azeite, e funda cidades antes dos outros.",
      en: "Resource management in 8th-century BC Sicily — gather grain, wine, and olive oil, and found cities before the others do.",
    },
  },
  {
    title: "Nine Oils",
    url: "https://nineoils.up.railway.app/",
    accentFrom: "#c49030",
    accentTo: "#1e1108",
    description: {
      pt: "Um jogo de sorte e vontade — atira 9 dados, junta combos e enche a tua banca de óleo de cobra antes do adversário.",
      en: "A game of luck and will — roll 9 dice, chain combos, and stock your snake-oil stall before your opponent does.",
    },
  },
];
---

<Layout locale={locale} altPath={pathTo(otherLocale, "playOnline")} title={copy.title} description={copy.subtitle}>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.title}</h1>
        <p>{copy.subtitle}</p>
      </div>

      {games.length > 0 ? (
        <div class="grid grid-3">
          {games.map((game) => (
            <a class="card" href={game.url} target="_blank" rel="noreferrer">
              <div
                class="card-media"
                aria-hidden="true"
                style={`background: linear-gradient(135deg, ${game.accentFrom} 0%, ${game.accentTo} 100%);`}
              >
                {game.title}
              </div>
              <div class="card-body">
                <h3 class="card-title">{game.title}</h3>
                <p class="card-excerpt">{game.description[locale]}</p>
                <div class="card-footer">
                  <span class="play-cta">{copy.openGame} &rarr;</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <span class="badge badge-soon">{"⏳"}</span>
          <div>
            <h2>{copy.comingSoonTitle}</h2>
            <p>{copy.comingSoonBody}</p>
          </div>
        </div>
      )}

      <p class="external-note">{copy.externalNote}</p>
    </div>
  </section>
</Layout>

<style>
  .play-cta {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--brand-primary);
  }

  .external-note {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .empty-state {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 640px;
    padding: 2rem;
    background: var(--bg-alt);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }

  .empty-state .badge {
    font-size: 1.1rem;
    padding: 0.55rem 0.7rem;
  }

  .empty-state h2 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .empty-state p {
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 500px) {
    .empty-state {
      flex-direction: column;
    }
  }
</style>
