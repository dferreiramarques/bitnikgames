---
import Layout from "../layouts/Layout.astro";
import PnpCard from "./PnpCard.astro";
import { pathTo, type Locale } from "../i18n/routes";
import { t } from "../i18n/ui";
import { sortEntries } from "../lib/sortEntries";
import { getPublished } from "../lib/getPublished";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).pnp;
const otherLocale: Locale = locale === "pt" ? "en" : "pt";

const items = sortEntries(await getPublished("pnp", locale));
const slugOf = (id: string) => id.split("/").slice(1).join("/");
---

<Layout locale={locale} altPath={pathTo(otherLocale, "printAndPlay")} title={copy.title} description={copy.subtitle}>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.title}</h1>
        <p>{copy.subtitle}</p>
      </div>
      <div class="grid grid-3">
        {items.map((item) => (
          <PnpCard locale={locale} item={item} slug={slugOf(item.id)} />
        ))}
      </div>
    </div>
  </section>
</Layout>
